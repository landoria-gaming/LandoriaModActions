<Project>
  <PropertyGroup>
    <ModRoot>$([System.IO.Path]::GetDirectoryName('$(ModProject)'))</ModRoot>
    <VersionMode>release</VersionMode>
  </PropertyGroup>
  <Import Project="versions.targets" />
  <Target Name="ValidateReleaseVersions" DependsOnTargets="ValidateModVersions" />
  <Target Name="PackageRelease" DependsOnTargets="ValidateReleaseVersions">
    <MSBuild Projects="$(ModProject)" Targets="PackageThunderstore" Properties="Configuration=Release;Platform=AnyCPU;SnapshotBuild=false" />
  </Target>
</Project>
